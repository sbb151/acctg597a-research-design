. * The shared panel, built after each set seed
. capture program drop fe_panel

. program define fe_panel
  1.     local N      900
  2.     local T      5
  3.     local pconst 0.08
  4.     local target 0.25
  5. 
.     clear
  6.     set obs `N'
  7.     gen int firm = _n
  8.     gen double mu = rnormal(0, 1)
  9.     gen byte constant = (_n <= round(`pconst' * `N'))
 10.     expand `T'
 11.     bysort firm: gen int year = _n
 12.     gen double lam = 0.25*(year==1) + 0.20*(year==2) + 0.10*(year==3) ///
>                    - 0.25*(year==4) - 0.30*(year==5)
 13.     gen double nu = rnormal(0, 1)
 14.     replace nu = 0 if constant
 15.     gen double A = mu + lam
 16.     replace A = -1.6 if constant
 17. 
.     * Solve SSW(k) = target * SST(k) for the scale k on nu (a quadratic in k)
.     foreach v in A nu {
 18.         bysort firm: egen double `v'_fm = mean(`v')
 19.         quietly summarize `v', meanonly
 20.         gen double `v'_w = `v' - `v'_fm
 21.         gen double `v'_t = `v' - r(mean)
 22.     }
 23.     foreach p in w t {
 24.         gen double aa_`p' = A_`p'^2
 25.         gen double an_`p' = A_`p' * nu_`p'
 26.         gen double nn_`p' = nu_`p'^2
 27.         foreach s in aa an nn {
 28.             quietly summarize `s'_`p', meanonly
 29.             scalar Z`s'`p' = r(sum)
 30.         }
 31.     }
 32.     * (scalars carry a Z prefix so that no variable name shadows them)
.     scalar qa = Znnw - `target' * Znnt
 33.     scalar qb = 2 * (Zanw - `target' * Zant)
 34.     scalar qc = Zaaw - `target' * Zaat
 35.     scalar k_scale = (-qb + sqrt(qb^2 - 4*qa*qc)) / (2*qa)
 36.     gen double vraw = A + k_scale * nu
 37.     drop A_* nu_* aa_* an_* nn_* A
 38. 
.     quietly summarize vraw
 39.     gen double vega = (vraw - r(mean)) / r(sd)
 40.     label variable vega "CFO vega, standardized by pooled mean and SD"
 41. 
.     * Realized within share (must equal the target)
.     bysort firm: egen double v_fm = mean(vega)
 42.     gen double v_w2 = (vega - v_fm)^2
 43.     gen double v_t2 = vega^2
 44.     quietly summarize v_w2, meanonly
 45.     scalar ssw_v = r(sum)
 46.     quietly summarize v_t2, meanonly
 47.     scalar sst_v = r(sum)
 48.     scalar share_w = ssw_v / sst_v
 49.     drop v_fm v_w2 v_t2
 50.     di "Panel: `N' firms x `T' years; scale k on nu = " %8.6f k_scale
 51.     di "Within-firm share of the sum of squares of vega (target `target'):
>  " %10.8f share_w
 52.     assert abs(share_w - `target') < 1e-8
 53.     xtset firm year
 54. end

. 
. 
