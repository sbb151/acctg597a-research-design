. *****************************************************************************
> ***
. * MODULE 2: which comparison each fixed effects choice draws (Kropko and Kubi
> nec)
. *****************************************************************************
> ***
. clear

. set seed 2014

. fe_panel
Number of observations (_N) was 0, now 900.
(3,600 observations created)
(360 real changes made)
(360 real changes made)
Panel: 900 firms x 5 years; scale k on nu = 0.666219
Within-firm share of the sum of squares of vega (target 0.25): 0.25000000

Panel variable: firm (strongly balanced)
 Time variable: year, 1 to 5
         Delta: 1 unit

. 
. local theta 0.0183

. local phi   0.03

. local gamma 0.0026

. 
. * ---- components of vega ---------------------------------------------------
> -----
. quietly summarize vega, meanonly

. scalar xbar = r(mean)

. bysort firm: egen double xb_i = mean(vega)

. bysort year: egen double xb_t = mean(vega)

. gen double B  = xb_i - xbar

. gen double Yc = xb_t - xbar

. gen double R  = vega - xb_i - xb_t + xbar

. foreach c in B Yc R {
  2.     gen double `c'2 = `c'^2
  3.     quietly summarize `c'2, meanonly
  4.     scalar SS`c' = r(sum)
  5. }

. scalar SStot = SSB + SSYc + SSR

. di "Shares of vega's sum of squares: between " %6.4f (SSB/SStot) ///
>    ", year " %6.4f (SSYc/SStot) ", two-way residual " %6.4f (SSR/SStot)
Shares of vega's sum of squares: between 0.7500, year 0.0325, two-way residual 
> 0.2175

. 
. * ---- outcome --------------------------------------------------------------
> -----
. bysort firm (year): gen double a_i = rnormal(0, 0.10) if _n == 1
(3,600 missing values generated)

. bysort firm (year): replace a_i = a_i[1]
(3600 real changes made)

. gen double sys = `theta'*B + `phi'*Yc + `gamma'*R        // systematic part

. gen double eq  = 0.603 + a_i + sys + rnormal(0, 0.10)

. label variable eq "Pension equity share"

. 
. * ---- estimators -----------------------------------------------------------
> ------
. program define fe4, rclass
  1.     * returns pooled, year FE, firm FE, two-way FE slopes of `1' on vega
.     quietly regress `1' vega
  2.     return scalar pool = _b[vega]
  3.     quietly regress `1' vega i.year
  4.     return scalar yfe = _b[vega]
  5.     quietly xtreg `1' vega, fe
  6.     return scalar ffe = _b[vega]
  7.     quietly xtreg `1' vega i.year, fe
  8.     return scalar tw = _b[vega]
  9. end

. fe4 sys

. foreach e in pool yfe ffe tw {
  2.     scalar S_`e' = r(`e')
  3. }

. fe4 eq

. foreach e in pool yfe ffe tw {
  2.     scalar E_`e' = r(`e')
  3. }

. quietly regress eq vega i.year, vce(cluster firm)

. scalar t_yfe = _b[vega] / _se[vega]

. quietly xtreg eq vega i.year, fe vce(cluster firm)

. scalar t_tw = _b[vega] / _se[vega]

. 
. di _n "Identity checks (should be zero to machine precision):"

Identity checks (should be zero to machine precision):

. * (4) systematic part: each estimator = SS-weighted average of kept slopes
. scalar L_pool = (`theta'*SSB + `phi'*SSYc + `gamma'*SSR) / SStot

. scalar L_yfe  = (`theta'*SSB + `gamma'*SSR) / (SSB + SSR)

. scalar L_ffe  = (`phi'*SSYc + `gamma'*SSR) / (SSYc + SSR)

. scalar L_tw   = `gamma'

. foreach e in pool yfe ffe tw {
  2.     di "  (4) `e' on systematic part minus weighted average of kept slopes
> : " %12.10f (S_`e' - L_`e')
  3.     assert abs(S_`e' - L_`e') < 1e-6
  4. }
  (4) pool on systematic part minus weighted average of kept slopes: 0.00000000
> 00
  (4) yfe on systematic part minus weighted average of kept slopes: 0.000000000
> 0
  (4) ffe on systematic part minus weighted average of kept slopes: 0.000000000
> 0
  (4) tw on systematic part minus weighted average of kept slopes: 0.0000000000

. 
. * ---- (1) firm FE as a weighted average of firm slopes (K&K Eqs 9-11) ------
> --------
. bysort firm: egen double y_i = mean(eq)

. gen double xw = vega - xb_i

. gen double yw = eq - y_i

. gen double xwyw = xw*yw

. gen double xw2  = xw^2

. * ---- (2) year FE as a weighted average of year slopes (K&K Eq 8) ----------
> --------
. bysort year: egen double y_t = mean(eq)

. gen double xy_ = vega - xb_t

. gen double yy_ = eq - y_t

. gen double xyyy = xy_*yy_

. gen double xy2  = xy_^2

. * ---- (3) two-way: Eq 12 and Eq 13 -----------------------------------------
> ----------
. quietly summarize eq, meanonly

. scalar ybar = r(mean)

. gen double ytw = eq - y_i - y_t + ybar

. gen double Rytw = R*ytw

. preserve

.     collapse (sum) n1 = xwyw d1 = xw2, by(firm)

.     gen double b_i = n1/d1
(72 missing values generated)

.     gen double wb = d1*b_i
(72 missing values generated)

.     quietly summarize wb, meanonly

.     scalar num1 = r(sum)

.     quietly summarize d1, meanonly

.     scalar den1 = r(sum)

. restore

. preserve

.     collapse (sum) n2 = xyyy d2 = xy2, by(year)

.     gen double b_t = n2/d2

.     gen double wb = d2*b_t

.     quietly summarize wb, meanonly

.     scalar num2 = r(sum)

.     quietly summarize d2, meanonly

.     scalar den2 = r(sum)

. restore

. quietly summarize Rytw, meanonly

. scalar n12 = r(sum)

. * Eq 13: within each year, regress firm-demeaned y on firm-demeaned x
. gen double ys = eq - y_i

. bysort year: egen double ys_t = mean(ys)

. bysort year: egen double xs_t = mean(xw)

. gen double xs_c = xw - xs_t

. gen double ys_c = ys - ys_t

. gen double n13 = xs_c*ys_c

. gen double d13 = xs_c^2

. preserve

.     collapse (sum) n13 d13, by(year)

.     gen double b13 = n13/d13

.     gen double wb = d13*b13

.     quietly summarize wb, meanonly

.     scalar num13 = r(sum)

.     quietly summarize d13, meanonly

.     scalar den13 = r(sum)

. restore

. di "  (1) firm FE minus sum(w_i b_i)/sum(w_i)      : " %12.10f (E_ffe - num1/
> den1)
  (1) firm FE minus sum(w_i b_i)/sum(w_i)      : -0.0000000000

. di "  (2) year FE minus sum(w_t b_t)/sum(w_t)      : " %12.10f (E_yfe - num2/
> den2)
  (2) year FE minus sum(w_t b_t)/sum(w_t)      : 0.0000000000

. di "  (3a) two-way FE minus K&K Eq 12 ratio         : " %12.10f (E_tw - n12/S
> SR)
  (3a) two-way FE minus K&K Eq 12 ratio         : 0.0000000000

. di "  (3b) two-way FE minus K&K Eq 13 average       : " %12.10f (E_tw - num13
> /den13)
  (3b) two-way FE minus K&K Eq 13 average       : -0.0000000000

. assert abs(E_ffe - num1/den1) < 1e-6

. assert abs(E_yfe - num2/den2) < 1e-6

. assert abs(E_tw - n12/SSR) < 1e-6

. assert abs(E_tw - num13/den13) < 1e-6

. 
. * ---- (5) the gap between firm FE and two-way FE (appendix B1) -------------
> -----------
. quietly regress eq vega i.firm i.year

. gen double d_hat = 0

. forvalues t = 2/5 {
  2.     quietly replace d_hat = _b[`t'.year] if year == `t'
  3. }

. gen double gap_term = d_hat*Yc

. quietly summarize gap_term, meanonly

. scalar gap_rhs = r(sum) / (SSYc + SSR)

. di "  (5) (firm FE - two-way FE) minus N sum d_t (xbar_t - xbar)/SSW: " %12.1
> 0f ((E_ffe - E_tw) - gap_rhs)
  (5) (firm FE - two-way FE) minus N sum d_t (xbar_t - xbar)/SSW: -0.0000000000

. assert abs((E_ffe - E_tw) - gap_rhs) < 1e-6

. 
. di _n "Numbers for the slides (x 1,000, as A&L report them):"

Numbers for the slides (x 1,000, as A&L report them):

. di "  shares: between " %6.4f (SSB/SStot) "  year " %6.4f (SSYc/SStot) "  res
> idual " %6.4f (SSR/SStot)
  shares: between 0.7500  year 0.0325  residual 0.2175

. di "  systematic part: pooled " %6.2f (1000*S_pool) "  year FE " %6.2f (1000*
> S_yfe) ///
>    "  firm FE " %6.2f (1000*S_ffe) "  two-way " %6.2f (1000*S_tw)
