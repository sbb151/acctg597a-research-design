. foreach e in pool yfe ffe tw {
  2.     local lab = cond("`e'"=="pool","None",cond("`e'"=="yfe","Year",cond("`
> e'"=="ffe","Firm","Firm and year")))
  3.     local kept = cond("`e'"=="pool","all",cond("`e'"=="yfe","between, resi
> dual",cond("`e'"=="ffe","year, residual","residual")))
  4.     local a : di %4.1f (1000*S_`e')
  5.     local b : di %4.1f (1000*E_`e')
  6.     file write tab "`lab' & `kept' & `=strtrim("`a'")' & `=strtrim("`b'")'
>  \\" _n
  7. }

. file write tab "\bottomrule" _n

. file write tab "\end{tabular}" _n

. file close tab

