. gen ws2 = ws^2

. gen s2z = `beta'^2*`sdw'^2 + `sige'^2

. gen muz = alpha + `beta'*`muw'

. gen A   = ws2*s2z + ws2*muz^2 + s2z

. gen D   = ws2*`sdw'^2 + ws2*`muw'^2 + `sdw'^2

. gen c1  = `muw'*ws2/D

. gen r2eq7 = D/A*(`beta' + alpha*c1)^2

. gen fine = 1

. keep alpha ws r2eq7 fine

