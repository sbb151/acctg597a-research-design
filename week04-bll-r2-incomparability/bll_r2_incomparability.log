. *****************************************************************************
> ***
. * MODULE 2: three ways to move R2 (BLL Eqs. (1)-(2) with alpha = 0)
. * DGP. w ~ N(2, sigma_w^2), eps ~ N(0, sigma_e^2), z = w + eps; s lognormal w
> ith
. * E(s) = 1 and CV omega_s (s = 1 when omega_s = 0); y = s z, x = s w; regress
>  y on x.
. *   baseline: sigma_w = 1, omega_s = 0, sigma_e = 1
. *   (a) sigma_w = sqrt(3);  (b) omega_s = 1;  (c) sigma_e = sqrt(3)
. * Population values: R2 = V/(V + sigma_e^2), V = sigma_w^2 + 4 omega_s^2/(1 +
>  omega_s^2);
. *   resid s.d. = sqrt(1 + omega_s^2) sigma_e; s.d.(x) = sqrt(omega_s^2 sigma_
> w^2 + 4 omega_s^2 + sigma_w^2).
. *   R2: 0.50, 0.75, 0.75, 0.25.  Resid s.d.: 1.00, 1.00, 1.41, 1.73.
. * Identity check (asserted to 1e-6): R2 = b^2 s2x/(b^2 s2x + s2e) in each sam
> ple.
. * Monte Carlo checks: R2 within 0.02, standard deviations within 0.05, of pop
> ulation values.
. *****************************************************************************
> ***
. clear all

. set seed 1999

. 
. local N    = 100000

. local beta = 1

. local muw  = 2

. 
. forvalues k = 0/3 {
  2.     local sdw  = 1
  3.     local ws   = 0
  4.     local sige = 1
  5.     if `k' == 1 local sdw  = sqrt(3)
  6.     if `k' == 2 local ws   = 1
  7.     if `k' == 3 local sige = sqrt(3)
  8.     clear
  9.     set obs `N'
 10.     gen w   = `muw' + `sdw'*rnormal()
 11.     gen eps = `sige'*rnormal()
 12.     gen z   = `beta'*w + eps
 13.     if `ws' == 0 {
 14.         gen s = 1
 15.     }
 16.     else {
 17.         local v = sqrt(ln(1 + `ws'^2))
 18.         gen s = exp(-0.5*`v'^2 + `v'*rnormal())
 19.     }
 20.     gen y = s*z
 21.     gen x = s*w
 22.     quietly reg y x
 23.     scalar b`k'   = _b[x]
 24.     scalar r2_`k' = e(r2)
 25.     scalar sde`k' = sqrt(e(rss)/(e(N) - 2))
 26.     scalar s2e`k' = e(rss)/(e(N) - 1)
 27.     quietly summarize x
 28.     scalar s2x`k' = r(Var)
 29.     scalar sdx`k' = r(sd)
 30.     local V = `sdw'^2 + `muw'^2*`ws'^2/(1 + `ws'^2)
 31.     scalar popr2`k'  = `beta'^2*`V'/(`beta'^2*`V' + `sige'^2)
 32.     scalar popsde`k' = sqrt(1 + `ws'^2)*`sige'
 33.     scalar popsdx`k' = sqrt(`ws'^2*`sdw'^2 + `ws'^2*`muw'^2 + `sdw'^2)
 34. }
