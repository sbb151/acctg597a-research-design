. *****************************************************************************
> ***
. * MODULE 1: Jennings identity, eq. (2) versus eq. (3)
. *****************************************************************************
> ***
. clear all

. set seed 1990

. 
. set obs 1000
Number of observations (_N) was 0, now 1,000.

. gen cfo = 0.15*rnormal()

. gen ta  = -0.4*cfo + 0.09*rnormal()

. gen inc = cfo + ta

. gen e   = 0.20*rnormal()

. gen ret1 = 0.30*cfo + 0.30*ta + e

. gen ret2 = 0.45*cfo + 0.15*ta + e

. 
. corr cfo ta
(obs=1,000)

             |      cfo       ta
-------------+------------------
         cfo |   1.0000
          ta |  -0.5596   1.0000


. 
. foreach k in 1 2 {
  2.     * ---- eq. (2): components ----
.     reg ret`k' cfo ta
  3.     scalar th1_`k'  = _b[cfo]
  4.     scalar th1t_`k' = _b[cfo]/_se[cfo]
  5.     scalar th2_`k'  = _b[ta]
  6.     scalar th2t_`k' = _b[ta]/_se[ta]
  7.     scalar r2a_`k'  = e(r2)
  8.     test cfo = ta
  9.     scalar Feq_`k'  = r(F)
 10.     * ---- eq. (3): component plus aggregate ----
.     reg ret`k' cfo inc
 11.     scalar g1_`k'   = _b[cfo]
 12.     scalar g1t_`k'  = _b[cfo]/_se[cfo]
 13.     scalar g2_`k'   = _b[inc]
 14.     scalar g2t_`k'  = _b[inc]/_se[inc]
 15.     scalar r2b_`k'  = e(r2)
 16.     test cfo
 17.     scalar Fzero_`k' = r(F)
 18. 
.     di _n "Economy `k' identity checks (should be zero to machine precision):
> "
 19.     di "  gamma1 minus (theta1 - theta2) : " %10.6f (g1_`k' - (th1_`k' - t
> h2_`k'))
 20.     di "  gamma2 minus theta2            : " %10.6f (g2_`k' - th2_`k')
 21.     di "  R2 eq.(2) minus R2 eq.(3)      : " %10.6f (r2a_`k' - r2b_`k')
 22.     di "  F(theta1 = theta2) minus F(gamma1 = 0) : " %10.6f (Feq_`k' - Fze
> ro_`k')
 23. }

