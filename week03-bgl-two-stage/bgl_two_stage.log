. *****************************************************************************
> ***
. * Module 3: orthogonalizing does not shrink the standard error
. *****************************************************************************
> ***
. set seed 19841201

. local N      = 303

. local reps   = 400

. local sig_e  = 0.19

. local sd_hc  = 0.216

. local sd_pre = 0.377

. 
. tempname sims

. tempfile simsfile repfile curvefile

. postfile `sims' rho sd_one sd_two se_formula using `simsfile', replace
(file /var/folders/ms/1p996tm15bz7p8szd7_97sk00000gn/T//St44160.000001 not
    found)

. di _n "Module 3: Monte Carlo (400 replications per correlation)"

Module 3: Monte Carlo (400 replications per correlation)

. foreach rho in 0 0.3 0.5 0.7 0.84 0.9 0.95 0.98 {
  2.     tempname acc
  3.     postfile `acc' b_one b_two using `repfile', replace
  4.     forvalues i = 1/`reps' {
  5.         quietly {
  6.             clear
  7.             set obs `N'
  8.             gen hc  = `sd_hc'*rnormal()
  9.             gen pre = `sd_pre'*(`rho'*(hc/`sd_hc') + sqrt(1 - `rho'^2)*rno
> rmal())
 10.             gen y   = 0.39*hc + `sig_e'*rnormal()
 11.             reg y hc pre
 12.             scalar b1 = _b[pre]
 13.             reg pre hc
 14.             predict z, resid
 15.             reg y hc z
 16.             scalar b2 = _b[z]
 17.             post `acc' (b1) (b2)
 18.         }
 19.     }
 20.     postclose `acc'
 21.     quietly use `repfile', clear
 22.     quietly sum b_one
 23.     scalar s1 = r(sd)
 24.     quietly sum b_two
 25.     scalar s2 = r(sd)
 26.     scalar sf = `sig_e'/(sqrt(`N')*`sd_pre'*sqrt(1 - `rho'^2))
 27.     di "  rho = " %4.2f `rho' "  sd(one regression) = " %6.4f s1 ///
>        "  sd(two-stage) = " %6.4f s2 "  formula = " %6.4f sf
 28.     post `sims' (`rho') (s1) (s2) (sf)
 29. }
