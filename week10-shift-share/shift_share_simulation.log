. *============================================================================
> ==
. * 3. Write the deck's data file
. *============================================================================
> ==
. tempname js

. file open `js' using "`outjs'", write replace

. file write `js' "/* Written by scripts/bartik_shift_share.do (seed 2025). Do 
> not edit by hand. */" _n

. file write `js' "window.SIMBARTIK = {" _n

. file write `js' "  seed: 2025, K: 30, C: 10, T: 8, n: 50, R: `R', beta: `beta
> ', nchange: 3," _n

. file write `js' "  edges: [-1, -0.5, 0, 0.5, 1]," _n

. file write `js' "  one: {" _n

. file write `js' "    paperFE: { ols: " %8.4f (s1_ols) ", rf: " %8.4f (s1_rf) 
> ", rfSE: " %8.4f (s1_rfse) ", iv: " %8.4f (s1_iv) ", ivSE: " %8.4f (s1_se) ",
>  F: " %8.1f (r1[1,4]) ", pi: " %8.4f (s1_fs) ", levelR2: " %6.3f (levR2) ", c
> orrWZ: " %6.3f (corrWZ) " }," _n

. file write `js' "    withinFE: { ols: " %8.4f (s2_ols) ", rf: " %8.4f (s2_rf)
>  ", iv: " %8.4f (s2_iv) ", ivSE: " %8.4f (s2_se) ", F: " %8.1f (r2[1,4]) ", p
> i: " %8.4f (s2_fs) " }," _n

. file write `js' "    binWeights: ["

. forvalues b = 1/6 {
  2.     file write `js' %8.4f (ab[`b',1])
  3.     if `b' < 6 file write `js' ", "
  4. }

. file write `js' "]," _n "    binEstimates: ["

. forvalues b = 1/6 {
  2.     if bb[`b',1] == . file write `js' "null"
  3.     else file write `js' %8.4f (bb[`b',1])
  4.     if `b' < 6 file write `js' ", "
  5. }

. file write `js' "]," _n "    countryWeights: ["

. forvalues c = 1/10 {
  2.     file write `js' %8.4f (ac[`c',1])
  3.     if `c' < 10 file write `js' ", "
  4. }

. file write `js' "]," _n "    countryEstimates: ["

. forvalues c = 1/10 {
  2.     if bc[`c',1] == . file write `js' "null"
  3.     else file write `js' %8.4f (bc[`c',1])
  4.     if `c' < 10 file write `js' ", "
  5. }

. file write `js' "]," _n "    countryWeightsWithin: ["

. forvalues c = 1/10 {
  2.     file write `js' %8.4f (ac2[`c',1])
  3.     if `c' < 10 file write `js' ", "
  4. }

. file write `js' "]," _n "    exampleShares: ["

. forvalues k = 1/3 {
  2.     file write `js' "["
  3.     forvalues b = 1/6 {
  4.         file write `js' %7.4f (S_ex[`k',`b'])
  5.         if `b' < 6 file write `js' ", "
  6.     }
  7.     file write `js' "]"
  8.     if `k' < 3 file write `js' ", "
  9. }

. file write `js' "]," _n "    tau: ["

. forvalues c = 1/10 {
  2.     file write `js' "["
  3.     forvalues t = 1/8 {
  4.         file write `js' %5.2f (tau[`c',`t'])
  5.         if `t' < 8 file write `js' ", "
  6.     }
  7.     file write `js' "]"
  8.     if `c' < 10 file write `js' ", "
  9. }

. file write `js' "] }," _n

. foreach g in A G H Q {
  2.     if "`g'" == "A" {
  3.         local key "lambda"
  4.         file write `js' "  lambda: [" _n
  5.     }
  6.     if "`g'" == "G" {
  7.         local key "gamma"
  8.         file write `js' "  gamma: [" _n
  9.     }
 10.     if "`g'" == "H" {
 11.         local key "C"
 12.         file write `js' "  countries: [" _n
 13.     }
 14.     if "`g'" == "Q" {
 15.         local key "e"
 16.         file write `js' "  compliance: [" _n
 17.     }
 18.     local rows = rowsof(`g')
 19.     forvalues j = 1/`rows' {
 20.         file write `js' "    { `key': " %6.2f (`g'[`j',1]) ", ols: " %8.4f
>  (`g'[`j',2]) ", rf: " %8.4f (`g'[`j',3]) ", iv: " %8.4f (`g'[`j',4]) ///
>             ", q1: " %8.4f (`g'[`j',5]) ", q3: " %8.4f (`g'[`j',6]) ", F: " %
> 9.1f (`g'[`j',7]) ", pi: " %8.4f (`g'[`j',8]) ", sd: " %8.4f (`g'[`j',9]) ", 
> maxw: " %8.4f (`g'[`j',10]) ///
>             ", seCY: " %8.4f (`g'[`j',11]) ", rejCY: " %6.3f (`g'[`j',12]) ",
>  se2W: " %8.4f (`g'[`j',19]) ", rej2W: " %6.3f (`g'[`j',20]) ", seC: " %8.4f 
> (`g'[`j',21]) ", rejC: " %6.3f (`g'[`j',22]) ///
>             ", ivWithin: " %8.4f (`g'[`j',13]) ", sdWithin: " %8.4f (`g'[`j',
> 14]) ", rfWithin: " %8.4f (`g'[`j',15]) ", FWithin: " %9.1f (`g'[`j',16]) ", 
> q1Within: " %8.4f (`g'[`j',17]) ", q3Within: " %8.4f (`g'[`j',18]) " }"
 21.         if `j' < `rows' file write `js' ","
 22.         file write `js' _n
 23.     }
 24.     file write `js' "  ]," _n
 25. }

. file write `js' "};" _n

. file close `js'

. di _n "Done: `outjs'"

Done: week10_breuer_bartik/js/sim-bartik.js

