> ==
. * 2. Monte Carlo grids (structure 1, the paper's, with structure 2 alongside)
. *============================================================================
> ==
. mata:
------------------------------------------------- mata (type end to exit) -----
: rseed(20252)

: R = `R'

: lam_grid = (0, 0.05, 0.1, 0.2, 0.3, 0.5)

: gam_grid = (0, 0.1, 0.25, 0.5, 1, 2)

: C_grid   = (3, 5, 10, 20)

: e_grid   = (1, 0.8, 0.6, 0.4, 0.2)

: // Columns: 1 grid value; structure 1: 2 mean OLS, 3 mean RF, 4 mean 2SLS, 5-
> 6 2SLS
: // quartiles, 7 mean F, 8 mean first-stage slope, 9 sd of 2SLS across draws, 
> 10 median
: // largest absolute country weight, 11 mean SE clustered by country-year, 12 
> rejection
: // rate of the true beta with that SE, 19 mean two-way clustered SE, 20 its r
> ejection
: // rate, 21 mean country-clustered SE, 22 its rejection rate; structure 2: 13
>  mean
: // 2SLS, 14 sd, 15 mean RF, 16 mean F, 17-18 2SLS quartiles.
: real matrix mc(real scalar R, real rowvector grid, real scalar which, real sc
> alar K, real scalar C0, real scalar T, real scalar n, real scalar beta)
> {
>     x = z = zlev = y = Zb = ctry = ind = cy = kc = iy = S = small = tau = Wb 
> = .
>     ab = bb = ac = bc = .
>     out = J(cols(grid), 22, .)
>     for (j=1; j<=cols(grid); j++) {
>         o  = J(R, 9, .)
>         o2 = J(R, 9, .)
>         w  = J(R, 1, .)
>         for (r=1; r<=R; r++) {
>             lambda = 0.5; gamma = 0; sig_rho = 0; nchange = 3; e = 1; C = C0
>             if (which == 1) lambda = grid[j]
>             if (which == 2) gamma  = grid[j]
>             if (which == 3) {
>                 C = grid[j]
>                 sig_rho = 0.3
>                 nchange = min((3, C))
>             }
>             if (which == 4) e = grid[j]
>             draw(K, C, T, n, lambda, gamma, sig_rho, nchange, e, beta, x, z, 
> zlev, y, Zb, ctry, ind, cy, kc, iy, S, small, tau, Wb)
>             o[r, .]  = est(x, z, y, Zb, ctry, K, C, T, 1, cy, kc, ab, bb, ac,
>  bc)
>             w[r]     = max(abs(ac))
>             o2[r, .] = est(x, z, y, Zb, ctry, K, C, T, 2, cy, kc, ab, bb, ac,
>  bc)
>         }
>         s   = sort(o[., 3], 1)
>         s2  = sort(o2[., 3], 1)
>         ws  = sort(w, 1)
>         rej   = mean(abs(o[., 3] :- beta) :/ o[., 6] :> 1.96)
>         rej2w = mean(abs(o[., 3] :- beta) :/ o[., 8] :> 1.96)
>         rejc  = mean(abs(o[., 3] :- beta) :/ o[., 9] :> 1.96)
>         out[j, .] = (grid[j], mean(o[., 1]), mean(o[., 2]), mean(o[., 3]), s[
> ceil(.25*R)], s[ceil(.75*R)], ///
>                      mean(o[., 4]), mean(o[., 5]), sqrt(variance(o[., 3])), w
> s[ceil(.5*R)], mean(o[., 6]), rej, ///
>                      mean(o2[., 3]), sqrt(variance(o2[., 3])), mean(o2[., 2])
> , mean(o2[., 4]), s2[ceil(.25*R)], s2[ceil(.75*R)], ///
>                      mean(o[., 8]), rej2w, mean(o[., 9]), rejc)
>     }
>     return(out)
> }

