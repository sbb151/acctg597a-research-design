. *****************************************************************************
> ***
. * MODULE 3: An omitted, mispriced correlate of accruals
. * Accruals and cash flows are rationally priced; an omitted variable Z (corre
> lated
. * with accruals, mispriced) makes accruals appear mispriced. Analytical gap 0
> .146.
. *****************************************************************************
> ***
. clear

. set seed 1996

. set obs 40679
Number of observations (_N) was 0, now 40,679.

. gen acc = rnormal(0,0.08)

. gen cf  = -0.5*acc + rnormal(0,0.08)

. gen z   = 0.5*acc + rnormal(0,0.08)

. gen e1  = 0.01 + 0.765*acc + 0.855*cf + 0*z + rnormal(0,0.06)

. gen ar  = 1.894*(e1 - 0.01 - 0.765*acc - 0.855*cf - 0.292*z) + rnormal(0,0.30
> )

. 
. mishkin e1 ar acc cf

. foreach s in g_1 gs_1 g_2 gs_2 {
  2.     local o`s' : di %5.3f r(`s')
  3.     local o`s' = strtrim("`o`s''")
  4. }

. local oLR : di %6.1f r(LR)

. local oLR = strtrim("`oLR'")

. scalar gap_o = r(gs_1)-r(g_1)

. di _n "Z omitted : gamma1 = " %6.3f r(g_1) "  gamma1* = " %6.3f r(gs_1) "  ga
> p = " %6.3f gap_o "  LR = " %7.1f r(LR)

Z omitted : gamma1 =  0.762  gamma1* =  0.916  gap =  0.154  LR =   215.0

. di "            gamma2 = " %6.3f r(g_2) "  gamma2* = " %6.3f r(gs_2)
            gamma2 =  0.853  gamma2* =  0.849

. di "  analytical gap = 0.146 ; simulated minus analytical = " %7.4f (gap_o-0.
> 146)
  analytical gap = 0.146 ; simulated minus analytical =  0.0082

. assert abs(gap_o-0.146) < 0.03

. 
. mishkin e1 ar acc cf z

. foreach s in g_1 gs_1 g_2 gs_2 g_3 gs_3 {
