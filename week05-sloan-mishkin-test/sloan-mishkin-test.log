. * ---------------------------------------------------------------------------
. * program mishkin: the Mishkin (1983) test by stacked weighted nonlinear leas
> t
. * squares.  Syntax: mishkin yfuture abret x1 x2 ... [, fast]
. *   Forecasting eq.: yfuture = a0 + sum g_k x_k + v
. *   Pricing eq.    : abret   = b*(yfuture - a0s - sum gs_k x_k) + e
. * The two equations are stacked (2n rows) and each row is weighted by the
. * inverse residual variance of its equation.  Option fast skips the nonlinear
. * fit of the unconstrained system and uses its OLS equivalent (see Module 1).
. * Returns r(LR), r(wald), r(b), r(g_k), r(gs_k) (Mishkin), r(go_k), r(gso_k) 
> (OLS).
. * ---------------------------------------------------------------------------
. capture program drop mishkin

. program define mishkin, rclass
  1.     syntax varlist(min=3) [, fast]
  2.     gettoken yf rest : varlist
  3.     gettoken ar xs : rest
  4.     local n = _N
  5.     * OLS, equation by equation
.     qui reg `yf' `xs'
  6.     tempname s1 s2 bo
  7.     scalar `s1' = e(rss)/e(N)
  8.     local init "a0 `=_b[_cons]'"
  9.     local k = 0
 10.     foreach x of local xs {
 11.         local ++k
 12.         return scalar go_`k' = _b[`x']
 13.         local init "`init' g`k' `=_b[`x']'"
 14.     }
 15.     qui reg `ar' `yf' `xs'
 16.     scalar `s2' = e(rss)/e(N)
 17.     scalar `bo' = _b[`yf']
 18.     return scalar bo = `bo'
 19.     local initu "`init' b `=`bo'' a0s `=-_b[_cons]/`bo''"
 20.     local initc "`initu'"
 21.     local k = 0
 22.     foreach x of local xs {
 23.         local ++k
 24.         return scalar gso_`k' = -_b[`x']/`bo'
 25.         local initu "`initu' gs`k' `=-_b[`x']/`bo''"
 26.     }
 27.     * OLS test that lagged information does not predict abnormal returns
.     qui reg `ar' `xs'
 28.     qui test `xs'
 29.     return scalar wald = r(df)*r(F)
 30.     * stack the two equations
.     preserve
 31.     tempvar id eq y d1 d2 w res
 32.     gen long `id' = _n
 33.     qui expand 2
 34.     bysort `id': gen byte `eq' = _n
 35.     gen double `y'  = cond(`eq'==1, `yf', `ar')
 36.     gen byte `d1' = `eq'==1
 37.     gen byte `d2' = `eq'==2
 38.     gen double `w' = cond(`eq'==1, 1/`s1', 1/`s2')
 39.     local fu "{a0}"
 40.     local pu "{a0s}"
 41.     local pc "{a0s}"
 42.     local k = 0
 43.     foreach x of local xs {
 44.         local ++k
 45.         local fu "`fu'+{g`k'}*`x'"
 46.         local pu "`pu'+{gs`k'}*`x'"
 47.         local pc "`pc'+{g`k'}*`x'"
 48.     }
 49.     if "`fast'"=="" {
 50.         qui nl (`y' = `d1'*(`fu') + `d2'*{b}*(`yf'-(`pu'))) [aw=`w'], init
> ial(`initu')
 51.         return scalar b = _b[/b]
 52.         local k = 0
 53.         foreach x of local xs {
 54.             local ++k
 55.             return scalar g_`k'  = _b[/g`k']
 56.             return scalar gs_`k' = _b[/gs`k']
 57.         }
 58.         qui predict double `res', resid
 59.         qui replace `res' = `res'^2*`w'
 60.         qui sum `res'
 61.         local ssru = r(sum)
 62.         drop `res'
 63.     }
 64.     else local ssru = 2*`n'
 65.     qui nl (`y' = `d1'*(`fu') + `d2'*{b}*(`yf'-(`pc'))) [aw=`w'], initial(
> `initc')
 66.     qui predict double `res', resid
 67.     qui replace `res' = `res'^2*`w'
 68.     qui sum `res'
 69.     return scalar LR = 2*`n'*ln(r(sum)/`ssru')
 70.     restore
 71. end

. 
. 
. *****************************************************************************
> ***
. * MODULE 1: The unconstrained Mishkin estimates are OLS
. * DGP with Sloan (1996, Table 5) values as the truth; N = 40,679.
. * The stacked weighted nonlinear system reproduces equation-by-equation OLS
. * (gamma_k* = -delta_k/b, asserted to 1e-6), and LR is close to the OLS Wald 
> statistic.
. *****************************************************************************
> ***
. clear

. set seed 1996

. set obs 40679
Number of observations (_N) was 0, now 40,679.

. gen acc = rnormal(0,0.08)

. gen cf  = -0.5*acc + rnormal(0,0.08)

. gen e1  = 0.01 + 0.765*acc + 0.855*cf + rnormal(0,0.06)

. gen ar  = 1.894*(e1 - 0.01 - 0.911*acc - 0.826*cf) + rnormal(0,0.30)

. 
. mishkin e1 ar acc cf

. di _n "Mishkin (stacked weighted NLS) versus OLS:"

Mishkin (stacked weighted NLS) versus OLS:

. di "  gamma1  : " %9.6f r(g_1)  "   OLS gamma1          : " %9.6f r(go_1)
  gamma1  :  0.763961   OLS gamma1          :  0.763961

. di "  gamma2  : " %9.6f r(g_2)  "   OLS gamma2          : " %9.6f r(go_2)
  gamma2  :  0.848919   OLS gamma2          :  0.848919

. di "  gamma1* : " %9.6f r(gs_1) "   OLS -delta1/b       : " %9.6f r(gso_1)
  gamma1* :  0.919456   OLS -delta1/b       :  0.919456

. di "  gamma2* : " %9.6f r(gs_2) "   OLS -delta2/b       : " %9.6f r(gso_2)
  gamma2* :  0.832380   OLS -delta2/b       :  0.832380

. di "  beta    : " %9.6f r(b)    "   OLS b               : " %9.6f r(bo)
  beta    :  1.895776   OLS b               :  1.895776

. di "  LR statistic: " %8.2f r(LR) "   OLS Wald chi2(2): " %8.2f r(wald)
  LR statistic:   245.20   OLS Wald chi2(2):   245.71

. di _n "Identity checks (should be zero to machine precision):"

Identity checks (should be zero to machine precision):

. di "  gamma1* minus (-delta1/b): " %12.8f (r(gs_1)-r(gso_1))
  gamma1* minus (-delta1/b):  -0.00000000

. di "  gamma2* minus (-delta2/b): " %12.8f (r(gs_2)-r(gso_2))
  gamma2* minus (-delta2/b):   0.00000000

. assert abs(r(g_1)-r(go_1))   < 1e-6

. assert abs(r(g_2)-r(go_2))   < 1e-6

. assert abs(r(gs_1)-r(gso_1)) < 1e-6

. assert abs(r(gs_2)-r(gso_2)) < 1e-6

. assert abs(r(b)-r(bo))       < 1e-6

. assert abs(r(LR)-r(wald))/r(wald) < 0.02

. 
. foreach s in g_1 g_2 gs_1 gs_2 b go_1 go_2 gso_1 gso_2 bo {
  2.     local f`s' : di %5.3f r(`s')
  3.     local f`s' = strtrim("`f`s''")
  4. }

. local fLR : di %6.1f r(LR)

. local fLR = strtrim("`fLR'")

. local fW  : di %6.1f r(wald)

. local fW  = strtrim("`fW'")

. file open tab using tables/tab_sloan_mishkin_test_identity.tex, write replace

