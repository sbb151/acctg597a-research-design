. forvalues i = 1/8 {
  2.     local m  : di %6.3f phi1[`i']
  3.     local m  = strtrim("`m'")
  4.     if abs(phi1[`i']) < 0.0005 local m "0.000"
  5.     local l  : di %6.3f lo[`i']
