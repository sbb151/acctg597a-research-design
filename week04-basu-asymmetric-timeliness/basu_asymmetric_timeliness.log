. *****************************************************************************
> ***
. * MODULE 1: The exact sample decomposition of the two Basu slopes
. *****************************************************************************
> ***
. * Week 4, Basu (1997): the exact sample decomposition of the two Basu slopes
. *
. * Demonstrates that within each sign-partitioned subsample the reverse slope
. * of earnings on returns equals the full-sample forward slope plus a sample-
. * variance-ratio (SVR) term plus a sample-truncation (ST) term, exactly, and
. * that Basu's interaction coefficient is the difference of the two subsample
. * slopes (Dietrich, Muller, and Riedl 2007, eqs. 1.7a-b and Table 2 Panels D-
> E).
. *
. * DGP (DMR eq. 1.1 with beta = lambda = 1, no conservatism): R = X + eta,
. * cov(X, eta) = 0, N = 50,000, moments calibrated to DMR Table 1:
. * sd(X) = 0.17 (var 0.029), sd(eta) = 0.497 (var 0.247, so var(R) = 0.276).
. *   Design 1: X and eta symmetric normal, split at the mean of R (zero).
. *   Design 2: X normal, eta right-skewed (standardized chi-square(2), mean 0,
. *             sd 0.497, skewness 2), split at zero; returns then have the lon
> g
. *             right tail of DMR Table 1.
. * Identities checked (zero to machine precision):
. *   full sample: delta = b s2_X/s2_R and R2 = delta b (DMR eq. 1.4; Basu fn. 
> 7)
. *   each half j: delta_j = b + SVR_j + ST_j, SVR_j = b s2_X,j/s2_R,j - b,
. *                ST_j = s_Xtau,j/s2_R,j, tau the full-sample forward residual
. *   each half j: delta_j^2 = R2_j s2_X,j/s2_R,j (Basu fn. 7)
. *   stacked regression: beta1 = delta_1 - delta_0, beta0 = delta_0 (DMR fn. 1
> 4)
. * Requirements: base Stata. Output: tables/tab_basu_identity.tex
. 
. clear all

. set seed 1997

. 
. local N = 50000

. 
. forvalues d = 1/2 {
  2.     clear
  3.     set obs `N'
  4.     gen X = 0.17*rnormal()
  5.     if `d' == 1 gen eta = 0.497*rnormal()
  6.     if `d' == 2 gen eta = 0.497*(rchi2(2) - 2)/2
  7.     gen R  = X + eta
  8.     gen DR = (R < 0)
  9.     gen RDR = R*DR
 10. 
.     * full-sample forward and reverse regressions
.     reg R X
 11.     scalar b`d' = _b[X]
 12.     scalar r2f`d' = e(r2)
 13.     predict tau, resid
 14.     reg X R
 15.     scalar dfull`d' = _b[R]
 16.     scalar r2r`d' = e(r2)
 17.     qui corr X R eta tau, cov
 18.     matrix C = r(C)
 19.     scalar vXf`d' = C[1,1]
 20.     scalar vRf`d' = C[2,2]
 21.     scalar cXetaf`d' = C[1,3]
 22. 
.     * stacked Basu regression
.     reg X DR R RDR
 23.     scalar bas0`d' = _b[R]
 24.     scalar bas1`d' = _b[RDR]
 25.     scalar bas1t`d' = _b[RDR]/_se[RDR]
 26. 
.     * subsamples: j = 0 good news (R >= 0), j = 1 bad news (R < 0)
.     forvalues j = 0/1 {
 27.         if `j' == 0 local cond "R >= 0"
 28.         else local cond "R < 0"
 29.         reg X R if `cond'
 30.         scalar del`d'`j' = _b[R]
 31.         scalar r2`d'`j'  = e(r2)
 32.         qui corr X R eta tau if `cond', cov
 33.         matrix C = r(C)
 34.         scalar vX`d'`j'    = C[1,1]
 35.         scalar vR`d'`j'    = C[2,2]
 36.         scalar cXeta`d'`j' = C[1,3]
 37.         scalar cXtau`d'`j' = C[1,4]
 38.         scalar svr`d'`j'   = b`d'*vX`d'`j'/vR`d'`j' - b`d'
 39.         scalar st`d'`j'    = cXtau`d'`j'/vR`d'`j'
 40.         scalar sum`d'`j'   = b`d' + svr`d'`j' + st`d'`j'
 41.     }
 42. 
.     di _n "Design `d' identity checks (should be zero to machine precision):"
 43.     di "  full: delta minus b*s2X/s2R          : " %10.6f (dfull`d' - b`d'
> *vXf`d'/vRf`d')
 44.     di "  full: R2(reverse) minus R2(forward)  : " %10.6f (r2r`d' - r2f`d'
> )
 45.     di "  full: R2 minus delta*b               : " %10.6f (r2r`d' - dfull`
> d'*b`d')
 46.     di "  full: cov(X, tau) (OLS orthogonality): " %10.6f C[1,4]
 47.     forvalues j = 0/1 {
 48.         di "  half `j': delta_j minus (b + SVR_j + ST_j): " %10.6f (del`d'
> `j' - sum`d'`j')
 49.         di "  half `j': delta_j^2 minus R2_j*s2X_j/s2R_j : " %10.6f (del`d
> '`j'^2 - r2`d'`j'*vX`d'`j'/vR`d'`j')
 50.         assert abs(del`d'`j' - sum`d'`j') < 1e-6
 51.         assert abs(del`d'`j'^2 - r2`d'`j'*vX`d'`j'/vR`d'`j') < 1e-6
 52.     }
 53.     di "  stacked: beta1 minus (delta_1 - delta_0): " %10.6f (bas1`d' - (d
> el`d'1 - del`d'0))
 54.     di "  stacked: beta0 minus delta_0            : " %10.6f (bas0`d' - de
> l`d'0)
 55.     assert abs(dfull`d' - b`d'*vXf`d'/vRf`d') < 1e-6
 56.     assert abs(r2r`d' - r2f`d') < 1e-6
 57.     assert abs(r2r`d' - dfull`d'*b`d') < 1e-6
 58.     assert abs(bas1`d' - (del`d'1 - del`d'0)) < 1e-6
 59.     assert abs(bas0`d' - del`d'0) < 1e-6
 60. 
.     di _n "Design `d' values:"
 61.     di "  forward slope b = " %6.3f b`d' "   full-sample reverse slope del
> ta = " %6.3f dfull`d' "   s2X/s2R = " %6.3f vXf`d'/vRf`d'
 62.     forvalues j = 0/1 {
 63.         di "  half `j': delta_j = " %7.3f del`d'`j' "  SVR_j = " %7.3f svr
> `d'`j' "  ST_j = " %7.3f st`d'`j' ///
>            "  cov(X,eta|j) = " %8.4f cXeta`d'`j' "  R2_j = " %6.3f r2`d'`j' "
>   s2X_j/s2R_j = " %6.3f vX`d'`j'/vR`d'`j'
 64.     }
 65.     di "  Basu beta1 = " %6.3f bas1`d' " (t = " %5.1f bas1t`d' ")"
 66. }
