  Basu Table 1 Panel A (printed beta1): 0.216;  Basu Table 2, XE (printed beta1
> ): 0.161

. assert abs((bad[1] - good[1]) - 0.161) < 0.0015

. assert (bad[3] - good[3]) > 0.216

