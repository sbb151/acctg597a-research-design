 13.     if `i' == 1 | `i' == 6 local cell "`m'"
 14.     else if phi1[`i'] > 0 local cell "\textcolor{Maroon}{\bfseries `m'}"
 15.     else local cell "\textcolor{DeepNavy}{\bfseries `m'}"
 16.     file write tab "`texlab`i'' & `cell' & `l', `h' & `rj'\% & `r2' \\" _n
 17. }

