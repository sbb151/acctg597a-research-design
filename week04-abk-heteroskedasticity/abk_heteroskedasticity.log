. scalar tcrit = invttail(`n' - 3, 0.025)

. foreach e in lev_c lev_w lev_h3 def_c def_w def_h3 {
  2.     local b = cond(substr("`e'", 1, 3) == "lev", "b_lev", "b_def")
  3.     gen rej_`e' = abs((`b' - `beta')/se_`e') > tcrit
  4. }

