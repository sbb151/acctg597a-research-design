. *****************************************************************************
> ***
. * MODULE 3: the conditional effect b1 + b3 W, centering, Johnson-Neyman bound
> aries, and a median split
. *****************************************************************************
> ***
. *****************************************************************************
> ***
. * ACCTG 597A -- Week 6 (mediation and moderation module)
. * In a moderation model Y = b1 X + b2 W + b3 XW + e, the effect of X on Y is
. * the conditional effect theta(W) = b1 + b3 W: b1 is the effect at W = 0, and
. * the Johnson-Neyman boundaries are the values of W where the conditional
. * effect's t statistic equals the critical value.
. *
. * Pure simulation, N = 500, X and W standard normal:
. *   Y = 0.15 X + 0.30 W + 0.25 X W + e,   e standard normal,
. * so theta(W) = 0.15 + 0.25 W, zero at W = -0.6.
. * Checks: mean-centered b1 equals b1 + b3 Wbar and b3 is unchanged (1e-6);
. * at each Johnson-Neyman root, absolute theta divided by its s.e. equals the
. * critical t (1e-6); lincom at W = 0 reproduces b1.
. * Also compares a median split of W (two subgroup slopes) with the b3 test.
. * Requirements: base Stata. Output: figures/fig3_mediation_moderation_conditi
> onal.png,
. *   tables/tab_mediation_moderation_probe.tex
. *****************************************************************************
> ***
. 
. clear all

. set seed 2017

. 
. set obs 500
Number of observations (_N) was 0, now 500.

. gen x  = rnormal()

. gen w  = rnormal()

. gen xw = x*w

. gen y  = 0.15*x + 0.30*w + 0.25*xw + rnormal()

. 
. * ---- The moderation regression ----
. reg y x w xw

      Source |       SS           df       MS      Number of obs   =       500
-------------+----------------------------------   F(3, 496)       =     29.58
       Model |  92.2344584         3  30.7448195   Prob > F        =    0.0000
    Residual |  515.596793       496  1.03950966   R-squared       =    0.1517
-------------+----------------------------------   Adj R-squared   =    0.1466
       Total |  607.831252       499   1.2180987   Root MSE        =    1.0196

------------------------------------------------------------------------------
           y | Coefficient  Std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
           x |   .1544008   .0443577     3.48   0.001     .0672487    .2415529
           w |   .2260694   .0478705     4.72   0.000     .1320156    .3201233
          xw |   .3076823   .0457671     6.72   0.000      .217761    .3976035
       _cons |   .0033461   .0458213     0.07   0.942    -.0866816    .0933738
------------------------------------------------------------------------------

. scalar b1  = _b[x]

. scalar b2  = _b[w]

. scalar b3  = _b[xw]

. scalar b1t = _b[x]/_se[x]

. scalar b3t = _b[xw]/_se[xw]

. scalar tcrit = invttail(e(df_r), 0.025)

. matrix V = e(V)

. scalar v11 = V[1,1]

. scalar v33 = V[3,3]

. scalar v13 = V[1,3]

. 
. * ---- Pick-a-point: theta(W) at W = -1, 0, +1 (standard deviations of W) ---
> -
. foreach k in -1 0 1 {
  2.     local kk = cond(`k' < 0, "m1", cond(`k' == 0, "0", "p1"))
  3.     lincom x + (`k')*xw
  4.     scalar th`kk'  = r(estimate)
  5.     scalar th`kk't = r(estimate)/r(se)
  6. }

 ( 1)  x - xw = 0

------------------------------------------------------------------------------
           y | Coefficient  Std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
         (1) |  -.1532815   .0642635    -2.39   0.017    -.2795436   -.0270193
------------------------------------------------------------------------------

 ( 1)  x = 0

------------------------------------------------------------------------------
           y | Coefficient  Std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
         (1) |   .1544008   .0443577     3.48   0.001     .0672487    .2415529
------------------------------------------------------------------------------

 ( 1)  x + xw = 0

------------------------------------------------------------------------------
           y | Coefficient  Std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
         (1) |   .4620831   .0632034     7.31   0.000     .3379037    .5862624
------------------------------------------------------------------------------

. di _n "Check: lincom at W = 0 minus b1 = " %12.8f (th0 - b1)

Check: lincom at W = 0 minus b1 =   0.00000000

. assert abs(th0 - b1) < 1e-6

. 
. * ---- Mean centering relabels b1 and leaves b3 unchanged ----
. sum w

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
           w |        500    .0298393    .9632573  -2.359229   2.502254

. scalar wbar = r(mean)

. gen wc  = w - wbar

. gen xwc = x*wc

. reg y x wc xwc

      Source |       SS           df       MS      Number of obs   =       500
-------------+----------------------------------   F(3, 496)       =     29.58
       Model |  92.2344572         3  30.7448191   Prob > F        =    0.0000
    Residual |  515.596794       496  1.03950967   R-squared       =    0.1517
-------------+----------------------------------   Adj R-squared   =    0.1466
       Total |  607.831252       499   1.2180987   Root MSE        =    1.0196

------------------------------------------------------------------------------
           y | Coefficient  Std. err.      t    P>|t|     [95% conf. interval]
-------------+----------------------------------------------------------------
           x |   .1635818    .044356     3.69   0.000     .0764331    .2507306
          wc |   .2260694   .0478705     4.72   0.000     .1320156    .3201233
         xwc |   .3076823   .0457671     6.72   0.000      .217761    .3976035
       _cons |   .0100919   .0457858     0.22   0.826    -.0798661    .1000499
------------------------------------------------------------------------------

. scalar b1c = _b[x]

. scalar b3c = _b[xwc]

. di "Check: centered b1 - (b1 + b3 Wbar) = " %12.8f (b1c - (b1 + b3*wbar))
Check: centered b1 - (b1 + b3 Wbar) =   0.00000000

. di "Check: b3 - centered b3            = " %12.8f (b3 - b3c)
Check: b3 - centered b3            =   0.00000001

. assert abs(b1c - (b1 + b3*wbar)) < 1e-6

. assert abs(b3 - b3c) < 1e-6

. 
. * ---- Johnson-Neyman boundaries: (b1 + b3 W)^2 = t^2 Var(b1 + b3 W) ----
. scalar qA = b3^2 - tcrit^2*v33

. scalar qB = 2*(b1*b3 - tcrit^2*v13)

. scalar qC = b1^2 - tcrit^2*v11

. scalar disc = qB^2 - 4*qA*qC

. assert disc > 0

. scalar wjn1 = (-qB - sqrt(disc))/(2*qA)

. scalar wjn2 = (-qB + sqrt(disc))/(2*qA)

. scalar wlo = min(wjn1, wjn2)

. scalar whi = max(wjn1, wjn2)

. foreach r in lo hi {
  2.     scalar th_`r' = b1 + b3*w`r'
  3.     scalar se_`r' = sqrt(v11 + 2*w`r'*v13 + w`r'^2*v33)
  4.     di "Check: at W = " %6.3f w`r' ", absolute t minus critical t = " %12.
> 8f (abs(th_`r')/se_`r' - tcrit)
  5.     assert abs(abs(th_`r')/se_`r' - tcrit) < 1e-6
  6. }
Check: at W = -0.889, absolute t minus critical t =  -0.00000000
Check: at W = -0.211, absolute t minus critical t =  -0.00000000

. di _n "b1 = " %6.3f b1 " (t = " %4.1f b1t "), b3 = " %6.3f b3 " (t = " %4.1f 
> b3t "), critical t = " %6.4f tcrit

b1 =  0.154 (t =  3.5), b3 =  0.308 (t =  6.7), critical t = 1.9648

. di    "theta(-1) = " %6.3f thm1 " (t = " %4.1f thm1t "); theta(0) = " %6.3f t
> h0 " (t = " %4.1f th0t "); theta(+1) = " %6.3f thp1 " (t = " %4.1f thp1t ")"
