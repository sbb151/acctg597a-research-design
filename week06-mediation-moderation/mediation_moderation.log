. *****************************************************************************
> ***
. * MODULE 5: the identity fixes the sum, not the split: a shared unobservable 
> and measurement error in M
. *****************************************************************************
> ***
. *****************************************************************************
> ***
. * ACCTG 597A -- Week 6 (mediation and moderation module)
. * The decomposition c = c' + ab holds in every sample by construction; what
. * moves is the split. An unobserved variable in both M and Y, or measurement
. * error in M, reallocates the total between the direct and indirect paths
. * while the total effect of an exogenous X stays unbiased.
. *
. * Monte Carlo, 500 samples of N = 2,000; X, U, all shocks standard normal.
. *   Design A (clean):        M = 0.5 X + e_M,           Y = 0.2 X + 0.8 M + e
> _Y
. *   Design B (U in M and Y): M = 0.5 X + 0.6 U + e_M,   Y = 0.2 X + 0.8 M + 0
> .6 U + e_Y
. *   Design C (noisy M):      observed M* = M_A + u,      Y = Y_A
. * True direct c' = 0.2, indirect ab = 0.4, total c = 0.6 in every design.
. * Population OLS values (derived in mediation_moderation_derivations.py):
. *   B: b -> 0.8 + 0.36/1.36 = 1.0647, ab -> 0.5324, c' -> 0.0676
. *   C: b -> 0.8 x 0.5 = 0.40,         ab -> 0.2000, c' -> 0.4000
. * Checks: c - (c' + ab) = 0 (1e-6) in every sample and design; Monte Carlo
. * means within 0.01 of the population values.
. * Requirements: base Stata. Output: figures/fig5_mediation_moderation_paths.p
> ng
. *****************************************************************************
> ***
. 
. clear all

. set seed 2012

. 
. local R = 500

. local N = 2000

. 
. tempname pf

. postfile `pf' rep dA iA cA dB iB cB dC iC cC viol using paths_mc, replace
(file paths_mc.dta not found)

. forvalues r = 1/`R' {
  2.     quietly {
  3.         clear
  4.         set obs `N'
  5.         gen x  = rnormal()
  6.         gen u  = rnormal()
  7.         gen em = rnormal()
  8.         gen ey = rnormal()
  9.         gen mn = rnormal()
 10.         gen mA = 0.5*x + em
 11.         gen yA = 0.2*x + 0.8*mA + ey
 12.         gen mB = 0.5*x + 0.6*u + em
 13.         gen yB = 0.2*x + 0.8*mB + 0.6*u + ey
 14.         gen mC = mA + mn
 15.         gen yC = yA
 16.         local viol = 0
 17.         foreach d in A B C {
 18.             reg m`d' x
 19.             local a  = _b[x]
 20.             reg y`d' x m`d'
 21.             local cp = _b[x]
 22.             local b  = _b[m`d']
 23.             reg y`d' x
 24.             local c  = _b[x]
 25.             local d`d' = `cp'
 26.             local i`d' = `a'*`b'
 27.             local c`d' = `c'
 28.             if abs(`c' - (`cp' + `a'*`b')) > 1e-6 local viol = `viol' + 1
 29.         }
 30.         post `pf' (`r') (`dA') (`iA') (`cA') (`dB') (`iB') (`cB') (`dC') (
> `iC') (`cC') (`viol')
 31.     }
 32. }

. postclose `pf'

. 
. use paths_mc, clear

. sum viol

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
        viol |        500           0           0          0          0

. di _n "Identity check: samples in which c - (c' + ab) exceeded 1e-6 (any desi
> gn): " r(max)

Identity check: samples in which c - (c' + ab) exceeded 1e-6 (any design): 0

. assert r(max) == 0

. collapse (mean) dA iA cA dB iB cB dC iC cC

. foreach v in dA iA cA dB iB cB dC iC cC {
  2.     scalar m_`v' = `v'[1]
  3. }

. 
. * population values
. scalar biasB = 0.6*0.6/(0.36 + 1)

. scalar pop_iB = 0.5*(0.8 + biasB)

. scalar pop_dB = 0.2 - 0.5*biasB

. scalar lam    = 1/(1 + 1)

. scalar pop_iC = 0.4*lam

. scalar pop_dC = 0.2 + 0.4*(1 - lam)

. 
. di _n "Monte Carlo means (`R' samples of N = `N'):"

Monte Carlo means (500 samples of N = 2000):

. di    "  Design A: direct " %6.3f m_dA "  indirect " %6.3f m_iA "  total " %6
> .3f m_cA "   (true 0.200, 0.400, 0.600)"
  Design A: direct  0.199  indirect  0.400  total  0.599   (true 0.200, 0.400, 
> 0.600)

. di    "  Design B: direct " %6.3f m_dB "  indirect " %6.3f m_iB "  total " %6
> .3f m_cB "   (population " %6.3f pop_dB ", " %6.3f pop_iB ", 0.600)"
  Design B: direct  0.066  indirect  0.533  total  0.599   (population  0.068, 
>  0.532, 0.600)

. di    "  Design C: direct " %6.3f m_dC "  indirect " %6.3f m_iC "  total " %6
> .3f m_cC "   (population " %6.3f pop_dC ", " %6.3f pop_iC ", 0.600)"
  Design C: direct  0.399  indirect  0.200  total  0.599   (population  0.400, 
>  0.200, 0.600)

. di _n "Checks (Monte Carlo mean minus population value, tolerance 0.01):"

Checks (Monte Carlo mean minus population value, tolerance 0.01):

. di    "  A direct " %8.4f (m_dA - 0.2) "  A indirect " %8.4f (m_iA - 0.4)
  A direct  -0.0009  A indirect  -0.0003

. di    "  B direct " %8.4f (m_dB - pop_dB) "  B indirect " %8.4f (m_iB - pop_i
> B)
  B direct  -0.0015  B indirect   0.0004

. di    "  C direct " %8.4f (m_dC - pop_dC) "  C indirect " %8.4f (m_iC - pop_i
> C)
  C direct  -0.0007  C indirect  -0.0005

. di    "  totals   " %8.4f (m_cA - 0.6) " " %8.4f (m_cB - 0.6) " " %8.4f (m_cC
>  - 0.6)
  totals    -0.0012  -0.0011  -0.0012

. assert abs(m_dA - 0.2) < 0.01 & abs(m_iA - 0.4) < 0.01

. assert abs(m_dB - pop_dB) < 0.01 & abs(m_iB - pop_iB) < 0.01

. assert abs(m_dC - pop_dC) < 0.01 & abs(m_iC - pop_iC) < 0.01

. assert abs(m_cA - 0.6) < 0.01 & abs(m_cB - 0.6) < 0.01 & abs(m_cC - 0.6) < 0.
> 01

. 
. * ---- Figure: stacked bars, direct (maroon) below indirect (navy) ----
. clear

. set obs 3
Number of observations (_N) was 0, now 3.

. gen pos = _n

. gen direct = .
(3 missing values generated)

