  4.     scalar cp`d't  = _b[x]/_se[x]
  5.     scalar b`d'    = _b[m]
  6.     scalar b`d't   = _b[m]/_se[m]
  7.     scalar bse`d'  = _se[m]
  8.     * Eq. (1): Y on X (the total effect c)
.     reg y`d' x
  9.     scalar c`d'    = _b[x]
