. di "  static DiD t-test rejects ATT = 0, all       : " %5.3f s_drej
  static DiD t-test rejects ATT = 0, all       : 0.901

. di "  static DiD t-test rejects ATT = 0, passers   : " %5.3f s_drej_p
  static DiD t-test rejects ATT = 0, passers   : 0.898

. di "  mean static delta, all / passers (true 0.35) : " %6.4f s_d " / " %6.4f 
> s_d_p
